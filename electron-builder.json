{
  "appId": "com.wurlding.app",
  "productName": "Wurlding",
  "copyright": "Copyright © 2026 Michael A Hernandez",
  "directories": {
    "output": "release"
  },
  "icon": "build/app-icon.png",
  "files": [
    "dist/**",
    "server.js",
    "electron/**",
    "package.json",
    "build/app-icon.png",
    "build/app-icon.ico",
    "build/Wurlding Icon.png"
  ],
  "extraResources": [],
  "asar": true,
  "asarUnpack": [
    "**/dist/critters/**"
  ],
  "win": {
    "icon": "build/app-icon.png",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/app-icon.ico",
    "uninstallerIcon": "build/app-icon.ico",
    "installerHeaderIcon": "build/app-icon.ico",
    "license": "build/eula.txt"
  },
  "publish": {
    "provider": "github",
    "owner": "SmallerBytes",
    "repo": "Wurlding"
  }
}

