{
  "name": "wurlding",
  "private": true,
  "version": "0.1.8",
  "description": "Worldbuilding and story tools for authors and game masters.",
  "author": "Michael A Hernandez",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmallerBytes/Wurlding.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n data,vite -c blue,green \"node server.js\" \"vite\"",
    "dev:vite": "vite",
    "dev:server": "node server.js",
    "dev:install": "set ELECTRON_USE_EXTERNAL_SERVER=1&& set WURLDING_PROFILE=dev&& electron .",
    "migrate:devdata": "node scripts/migrate-dev-data.cjs",
    "gen:notices": "node scripts/generate-third-party-notices.cjs",
    "prebuild": "npm run gen:notices",
    "build": "tsc -b && vite build",
    "build:install": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build && electron-builder",
    "release:github": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build && electron-builder --publish always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "lucide-react": "^1.7.0",
    "multer": "^2.1.1",
    "nanoid": "^5.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "unzipper": "^0.12.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
